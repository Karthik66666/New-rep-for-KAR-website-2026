# Upload only the static site and the serverless runtime, never local private data.
/*
# Keep parent exceptions slashless: Vercel checks bare directory names before descending.
!/api
!/api/**
!/dist
!/dist/**
!/backend.mjs
!/cloud-store.mjs
!/package.json
!/package-lock.json
!/vercel.json
!/.vercelignore

# Also exclude sensitive or temporary files accidentally nested in allowed folders.
**/.kar-data/
**/.env*
**/.git/
**/.openai/
**/.vercel/
**/node_modules/
**/tests/
**/recordings/
**/*.log
**/*.mp4
**/*.mov
**/*.webm
**/*.tar.gz
**/*.zip
